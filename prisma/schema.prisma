generator client {
  provider = "prisma-client-js"
}

// SQLite locally; keep every type Postgres-compatible (no SQLite-only features).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plugin {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  version     String?
  description String?
  authorName  String?
  homepage    String?
  repository  String?
  license     String?
  // JSON-encoded string[] (SQLite has no native arrays)
  keywords    String  @default("[]")
  // Raw plugin.json text as fetched
  manifest    String
  // Canonical manifest path selected for display.
  manifestPath String @default("plugin.json")
  // JSON-encoded protocol identifiers and per-protocol raw manifests.
  protocols    String @default("[\"agent-plugins\"]")
  manifests    String @default("{}")
  // JSON-encoded map of runtime to a source-published marketplace identity.
  // Null means the repository has not yet been checked; "{}" means checked
  // and no matching upstream marketplace entry was found.
  upstreamMarketplaces String?

  // Source repo metadata
  repoUrl      String
  // GitHub owner login derived from repoUrl ("" when the host is not GitHub).
  repoOwner    String    @default("")
  // Path of the plugin directory within the repo ("" = repo root)
  pluginPath   String    @default("")
  repoStars    Int       @default(0)
  repoForks    Int       @default(0)
  repoOpenIssues Int     @default(0)
  repoPushedAt DateTime?

  skillCount Int @default(0)
  mcpCount   Int @default(0)

  skills     Skill[]
  mcpServers McpServer[]

  createdAt DateTime @default(now())
  indexedAt DateTime @updatedAt

  @@unique([repoUrl, pluginPath])
  @@index([repoStars])
  @@index([repoOwner])
  @@index([indexedAt])
}

model Skill {
  id          String  @id @default(cuid())
  pluginId    String
  plugin      Plugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  // Directory name under skills/
  dirName     String
  // Manifest-relative path to SKILL.md (supports Claude's root SKILL.md form).
  path        String  @default("")
  name        String
  description String?
  // JSON-encoded SKILL.md frontmatter
  frontmatter String  @default("{}")

  @@unique([pluginId, dirName])
}

model McpServer {
  id       String @id @default(cuid())
  pluginId String
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  // Key in mcp.json's mcpServers map
  serverId String
  // "stdio" | "streamable-http" | "sse"
  transport String
  // JSON-encoded server config (command/args/url/... as declared)
  config   String

  @@unique([pluginId, serverId])
}
